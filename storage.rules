rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isUserActive() {
      return isSignedIn() &&
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             getUserData().status == 'ACTIVE' &&
             getUserData().disabled != true;
    }

    function isAdmin() {
      return isUserActive() &&
             request.auth.token.role == 'ADMIN' &&
             getUserData().role == 'ADMIN';
    }

    function isAuthorizedTeamManager() {
      return isUserActive() &&
             request.auth.token.role == 'TEAM_MANAGER' &&
             getUserData().role == 'TEAM_MANAGER' &&
             request.auth.token.teamId != null &&
             getUserData().teamId == request.auth.token.teamId;
    }

    function isImageFile() {
      return request.resource != null &&
             request.resource.contentType.matches('image/.*') &&
             request.resource.size < 5 * 1024 * 1024; // Max 5MB
    }

    function getParticipantData(participantId) {
      return firestore.get(/databases/(default)/documents/participants/$(participantId)).data;
    }

    function isParticipantOwner(participantId) {
      return isAuthorizedTeamManager() &&
             firestore.exists(/databases/(default)/documents/participants/$(participantId)) &&
             getParticipantData(participantId).teamId == request.auth.token.teamId;
    }

    function isMetadataConsistent() {
      return request.resource.metadata == null ||
             !('teamId' in request.resource.metadata) ||
             request.resource.metadata.teamId == request.auth.token.teamId;
    }

    // Participant Profile Photos (Direct Participant Path)
    // Protected from public read; strictly restricted to Admin & authoritative Team Manager
    match /participants/{participantId}/{fileName} {
      allow read: if isAdmin() || isParticipantOwner(participantId);
      allow create, update: if (isAdmin() || (isParticipantOwner(participantId) && isMetadataConsistent())) && isImageFile();
      allow delete: if isAdmin() || isParticipantOwner(participantId);
    }

    // Participant Profile Photos (Nested Team Path)
    match /teams/{teamId}/participants/{participantId}/{fileName} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.role == 'TEAM_MANAGER' &&
        request.auth.token.teamId == teamId &&
        isParticipantOwner(participantId)
      );
      allow create, update: if (
        isAdmin() || (
          isSignedIn() &&
          request.auth.token.role == 'TEAM_MANAGER' &&
          request.auth.token.teamId == teamId &&
          isParticipantOwner(participantId) &&
          isMetadataConsistent()
        )
      ) && isImageFile();
      allow delete: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.role == 'TEAM_MANAGER' &&
        request.auth.token.teamId == teamId &&
        isParticipantOwner(participantId)
      );
    }

    // Festival Branding & Logos
    match /branding/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageFile();
      allow delete: if isAdmin();
    }

    // Generated Result Posters & Certificates
    match /posters/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageFile();
      allow delete: if isAdmin();
    }

    // Tabulation Register PDFs
    match /exports/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
