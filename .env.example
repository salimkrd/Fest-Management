# ==========================================
# FEST MANAGEMENT APPLICATION ENVIRONMENT TEMPLATE
# Project: Fest Management Web Application (Sahithyolsav 2025)
# ==========================================

# ------------------------------------------
# 1. CLIENT-SIDE FIREBASE WEB CONFIGURATION
# (Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
# Note: Newer Firebase projects use <project-id>.firebasestorage.app for storageBucket
# ------------------------------------------
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------
# 2. EMULATOR ISOLATION CONTROLS
# ------------------------------------------
# Set to 'true' ONLY for local development against Firebase Emulator Suite.
# Set to 'false' to target the live Firebase project.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR="false"

# Local Emulator Ports (active only when NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true)
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"

FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"

# ------------------------------------------
# 3. SERVER-SIDE FIREBASE ADMIN SDK CONFIGURATION
# (Used strictly in server-side actions, never exposed via NEXT_PUBLIC)
# In production, provide credentials via environment variables or
# GOOGLE_APPLICATION_CREDENTIALS pointing to a secure service account JSON file outside the workspace.
# Note: ADMIN_BOOTSTRAP_SECRET is NOT needed in web application deployment (retired).
# ------------------------------------------
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# ------------------------------------------
# 4. CANONICAL APPLICATION DOMAIN & ACTIVATION BASE URL
# REQUIRED in Production: Must be explicitly configured with your trusted HTTPS domain
# (e.g., NEXT_PUBLIC_APP_URL="https://fest.example.com" or your Vercel production domain).
# In production, arbitrary forwarded host headers (x-forwarded-host, host) are strictly
# rejected to prevent Host Header Injection attacks.
# In local development and test environments, this safely defaults to http://localhost:3000 if unset.
# ------------------------------------------
NEXT_PUBLIC_APP_URL="https://fest.example.com"
